# Without this, setuptools ships the test modules but not conftest.py or the package
# marker, so the sdist carries a suite that cannot run. Anyone building from source to
# verify the package deserves a working one.
include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
recursive-include tests *.py
recursive-include docs *.md
recursive-include examples *.py
global-exclude __pycache__
global-exclude *.py[cod]
